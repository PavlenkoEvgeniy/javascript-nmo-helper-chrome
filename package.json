{
  "name": "nmo-helper",
  "version": "1.1.3",
  "description": "Chrome extension (MV3): reads an NMO test page and builds an AI prompt.",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:content && npm run build:popup && npm run copy",
    "build:content": "esbuild src/content/index.ts --bundle --outfile=dist/content.js --platform=browser --target=es2022 --format=iife",
    "build:popup": "esbuild src/popup/index.ts --bundle --outfile=dist/popup.js --platform=browser --target=es2022 --format=iife",
    "copy": "node scripts/copy.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src scripts tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:version": "node scripts/check-version.mjs",
    "package": "npm run check:version && npm run build && node scripts/package.mjs",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:version"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.18",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
